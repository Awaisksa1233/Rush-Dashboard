{
  "name": "rush-crm-analytics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:full": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev\"",
    "db:sync": "node scripts/sync_atlas_db.js",
    "db:sync:process": "node scripts/sync_atlas_db.js --process",
    "db:sync:full": "node scripts/sync_atlas_db.js --full",
    "db:process": "python scripts/process_mongo_data.py",
    "db:download": "node scripts/download_atlas_db.js",
    "db:restore:local": "node scripts/restore_to_local_mongo.js",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.460.0",
    "mongodb": "^7.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
